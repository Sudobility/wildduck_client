{
  "name": "@sudobility/wildduck_client",
  "version": "2.3.109",
  "description": "React and React Native compatible client library for WildDuck email API with TypeScript support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check-all": "bun run lint && bun run typecheck && bun run test:unit"
  },
  "keywords": [
    "wildduck",
    "email",
    "client",
    "react",
    "react-native",
    "typescript"
  ],
  "author": "Sudobility Team",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/di": "^1.5.77",
    "@sudobility/mail_box_types": "^1.0.32",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@sudobility/configs": "^0.0.82",
    "@sudobility/di": "^1.5.77",
    "@sudobility/mail_box_types": "^1.0.32",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~3.2.7",
    "axios": "~1.20.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~6.1.1",
    "happy-dom": "~20.14.6",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "viem": "~2.57.10",
    "vite": "~7.3.7",
    "vitest": "~3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/wildduck_client.git"
  },
  "bugs": {
    "url": "https://github.com/johnqh/wildduck_client/issues"
  },
  "homepage": "https://github.com/johnqh/wildduck_client#readme",
  "publishConfig": {
    "access": "public"
  }
}
